# Configuração privada. Não versione valores reais.
# Nuxt dev: npm run dev -- --dotenv .env.local
# Node do build: injete as variáveis no processo; não carrega .env.local automaticamente.
# Sem estes valores, o acesso administrativo permanece fechado com 503.
NUXT_AUTH_SECRET=
# Origem exata, sem caminho ou barra final.
NUXT_AUTH_BASE_URL=http://localhost:3000
NUXT_AUTH_DATABASE_URL=
NUXT_DOMAIN_DATABASE_URL=
# URLs de banco devem usar auth_runtime e app_runtime, respectivamente.
# Não use postgres, table owner, BYPASSRLS ou credenciais de outro projeto.

# Transporte de desenvolvimento, somente loopback. npm run mail:local gera os valores privados.
NUXT_AUTH_MAIL_URL=
NUXT_AUTH_MAIL_SECRET=
